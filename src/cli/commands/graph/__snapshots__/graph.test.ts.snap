// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`graph command mermaid output 1`] = `
"graph TD
  subgraph discovery_phase ["Discovery"]
    discovery["Discover Videos"]
  end
  discovery --> download_vid_aaa & download_vid_bbb

  subgraph pipeline_phase ["Execution"]
    subgraph video_1 ["Video 1"]
      download_vid_aaa["Download Audio"]
      transcribe_vid_aaa["Transcribe"]
      thumbnail_vid_aaa["Crop Thumbnail"]
      chapters_vid_aaa["Generate Chapters"]
      embed_chapters_vid_aaa["Embed Chapters"]
      summary_vid_aaa["Summarize"]
      rss_entry_vid_aaa["RSS Entry"]
      download_vid_aaa --> transcribe_vid_aaa
      download_vid_aaa --> thumbnail_vid_aaa
      download_vid_aaa & transcribe_vid_aaa --> chapters_vid_aaa
      download_vid_aaa & chapters_vid_aaa --> embed_chapters_vid_aaa
      download_vid_aaa & transcribe_vid_aaa --> summary_vid_aaa
      download_vid_aaa & transcribe_vid_aaa & thumbnail_vid_aaa & chapters_vid_aaa & embed_chapters_vid_aaa & summary_vid_aaa --> rss_entry_vid_aaa
    end
    subgraph video_2 ["Video 2"]
      download_vid_bbb["Download Audio"]
      transcribe_vid_bbb["Transcribe"]
      thumbnail_vid_bbb["Crop Thumbnail"]
      chapters_vid_bbb["Generate Chapters"]
      embed_chapters_vid_bbb["Embed Chapters"]
      summary_vid_bbb["Summarize"]
      rss_entry_vid_bbb["RSS Entry"]
      download_vid_bbb --> transcribe_vid_bbb
      download_vid_bbb --> thumbnail_vid_bbb
      download_vid_bbb & transcribe_vid_bbb --> chapters_vid_bbb
      download_vid_bbb & chapters_vid_bbb --> embed_chapters_vid_bbb
      download_vid_bbb & transcribe_vid_bbb --> summary_vid_bbb
      download_vid_bbb & transcribe_vid_bbb & thumbnail_vid_bbb & chapters_vid_bbb & embed_chapters_vid_bbb & summary_vid_bbb --> rss_entry_vid_bbb
    end
    channel_avatar["Fetch Avatar"]
    artwork["Process Artwork"]
    channel_avatar --> artwork
  end

  subgraph publish_phase ["Publish"]
    publish["Upload + Feed"]
  end
  rss_entry_vid_aaa & rss_entry_vid_bbb & artwork --> publish

  style discovery_phase fill:#fef7ed,stroke:#e8a95b,color:#7c4d1a
  style pipeline_phase fill:#f1f5f9,stroke:#94a3b8,color:#334155
  style publish_phase fill:#fefce8,stroke:#d4a017,color:#5c4a00
  style video_1 fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95
  style video_2 fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95
  style discovery fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style download_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style transcribe_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style thumbnail_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style chapters_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style embed_chapters_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style summary_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style rss_entry_vid_aaa fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style download_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style transcribe_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style thumbnail_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style chapters_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style embed_chapters_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style summary_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style rss_entry_vid_bbb fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style channel_avatar fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style artwork fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style publish fill:#fbbf24,stroke:#b45309,color:#451a03
  style discovery fill:#c2742f,stroke:#7c2d12,color:#fff"
`;
