// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`graph command mermaid output 1`] = `
"graph TD
  subgraph discovery_phase ["Discovery"]
    discovery["Discover Videos"]
  end
  discovery --> vid_aaa_download & vid_bbb_download

  subgraph pipeline_phase ["Execution"]
    subgraph video_1 ["Video 1"]
      vid_aaa_download["Download Audio"]
      vid_aaa_transcribe["Transcribe"]
      vid_aaa_thumbnail["Crop Thumbnail"]
      vid_aaa_chapters["Generate Chapters"]
      vid_aaa_embed_chapters["Embed Chapters"]
      vid_aaa_summary["Summarize"]
      vid_aaa_rss_entry["RSS Entry"]
      vid_aaa_download --> vid_aaa_transcribe
      vid_aaa_download --> vid_aaa_thumbnail
      vid_aaa_download & vid_aaa_transcribe --> vid_aaa_chapters
      vid_aaa_download & vid_aaa_chapters --> vid_aaa_embed_chapters
      vid_aaa_download & vid_aaa_transcribe --> vid_aaa_summary
      vid_aaa_download & vid_aaa_transcribe & vid_aaa_thumbnail & vid_aaa_chapters & vid_aaa_embed_chapters & vid_aaa_summary --> vid_aaa_rss_entry
    end
    subgraph video_2 ["Video 2"]
      vid_bbb_download["Download Audio"]
      vid_bbb_transcribe["Transcribe"]
      vid_bbb_thumbnail["Crop Thumbnail"]
      vid_bbb_chapters["Generate Chapters"]
      vid_bbb_embed_chapters["Embed Chapters"]
      vid_bbb_summary["Summarize"]
      vid_bbb_rss_entry["RSS Entry"]
      vid_bbb_download --> vid_bbb_transcribe
      vid_bbb_download --> vid_bbb_thumbnail
      vid_bbb_download & vid_bbb_transcribe --> vid_bbb_chapters
      vid_bbb_download & vid_bbb_chapters --> vid_bbb_embed_chapters
      vid_bbb_download & vid_bbb_transcribe --> vid_bbb_summary
      vid_bbb_download & vid_bbb_transcribe & vid_bbb_thumbnail & vid_bbb_chapters & vid_bbb_embed_chapters & vid_bbb_summary --> vid_bbb_rss_entry
    end
    channel_avatar["Fetch Avatar"]
    artwork["Process Artwork"]
    channel_avatar --> artwork
  end

  subgraph publish_phase ["Publish"]
    publish["Upload + Feed"]
  end
  vid_aaa_rss_entry & vid_bbb_rss_entry & artwork --> publish

  style discovery_phase fill:#fef7ed,stroke:#e8a95b,color:#7c4d1a
  style pipeline_phase fill:#f1f5f9,stroke:#94a3b8,color:#334155
  style publish_phase fill:#fefce8,stroke:#d4a017,color:#5c4a00
  style video_1 fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95
  style video_2 fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95
  style discovery fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_download fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_transcribe fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_thumbnail fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_chapters fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_embed_chapters fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_summary fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_aaa_rss_entry fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_bbb_download fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_bbb_transcribe fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_bbb_thumbnail fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_bbb_chapters fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_bbb_embed_chapters fill:#cbd5e1,stroke:#64748b,color:#0f172a
  style vid_bbb_summary fill:#cbd5e1,stroke:#64748b,color:#0f172a
