{
  "name": "podpiper",
  "module": "src/cli/cli.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "podpiper-cli": "./src/cli/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "verify": "bun test & tsgo --noEmit & eslint . & wait",
    "env": "op inject -i .env.tpl -o .env",
    "check-deps": "bun scripts/check-deps.ts",
    "install-plist": "launchctl unload ~/Library/LaunchAgents/com.podpiper.serve.plist 2>/dev/null; cp com.podpiper.serve.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.podpiper.serve.plist"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.15.0",
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6",
    "@typescript/native-preview": "^7.0.0-dev.20260131.1",
    "eslint": "^10.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@temporalio/activity": "^1.15.0",
    "@temporalio/client": "^1.15.0",
    "@temporalio/common": "^1.15.0",
    "@temporalio/worker": "^1.15.0",
    "@temporalio/workflow": "^1.15.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.3.4",
    "node-id3": "^0.2.9",
    "picocolors": "^1.1.1"
  }
}
